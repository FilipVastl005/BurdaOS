#!/bin/sh
# Resolve installed GNOME extension UUIDs, compile GSettings/dconf databases,
# enable system services, and set OS branding.
set -e

echo "[BurdaOS Hook] Resolving installed GNOME Shell extension UUIDs..."
EXT_DIR="/usr/share/gnome-shell/extensions"
if [ -d "$EXT_DIR" ]; then
    EXT_LIST=""
    for pattern in \
        "user-theme*" \
        "dash-to-dock*" \
        "appindicator*" \
        "ding*" \
        "*gpaste*" \
        "*GPaste*" \
        "*tiling-assistant*" \
        "*caffeine*" \
        "*system-monitor*" \
        "*impatience*"
    do
        for path in "$EXT_DIR"/$pattern; do
            [ -d "$path" ] || continue
            uuid=$(basename "$path")
            case ",$EXT_LIST," in
                *",'$uuid',"* ) ;;
                * )
                    if [ -z "$EXT_LIST" ]; then
                        EXT_LIST="'$uuid'"
                    else
                        EXT_LIST="$EXT_LIST, '$uuid'"
                    fi
                    ;;
            esac
        done
    done

    if [ -n "$EXT_LIST" ]; then
        mkdir -p /etc/dconf/db/local.d
        cat > /etc/dconf/db/local.d/01-burdaos-extensions << EOF
[org/gnome/shell]
disable-user-extensions=false
enabled-extensions=[${EXT_LIST}]
EOF
        echo "[BurdaOS Hook] Enabled extensions: [${EXT_LIST}]"
    fi
fi

echo "[BurdaOS Hook] Compiling GLib GSettings schemas..."
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || true
fi

echo "[BurdaOS Hook] Compiling dconf local & GDM databases..."
if command -v dconf >/dev/null 2>&1; then
    dconf update
fi

echo "[BurdaOS Hook] Enabling systemd services (gdm3, NetworkManager, zramswap, binfmt-support)..."
for svc in gdm3 NetworkManager zramswap binfmt-support; do
    systemctl enable "$svc" >/dev/null 2>&1 || true
done

echo "[BurdaOS Hook] Updating /etc/os-release branding..."
if [ -f /etc/os-release ]; then
    sed -i 's/^NAME=.*/NAME="BurdaOS"/' /etc/os-release || true
    sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="BurdaOS (Debian 12 Bookworm)"/' /etc/os-release || true
fi
