[Desktop Entry]
Type=Application
Name=Wine Windows Program Loader
Comment=Run Windows executables (.exe / .msi) via system-level Wine
Exec=wine start /unix %f
MimeType=application/x-ms-dos-executable;application/x-dosexec;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;
Icon=wine
NoDisplay=true
Terminal=false
Categories=System;Emulator;
